# Keep LF regardless of core.autocrlf; detect binaries automatically.
* text=auto eol=lf

# cmd.exe requires CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# These fixtures must match the Blender parity corpus byte-for-byte.
src/Paradise.Assets.Documents.Test/Fixtures/parity/** -text

# Native and texture assets, including the extensionless ktx executable.
*.ktx2 -text
*.dylib -text
*.so -text
*.dll -text
third_party/tools/KTX-Software/Darwin-arm64/bin/ktx -text
