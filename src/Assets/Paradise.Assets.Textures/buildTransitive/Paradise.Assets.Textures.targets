<Project>

  <!--
    Browser-wasm has no dynamic loader, so libktx is linked into dotnet.native.wasm when the app
    relinks. NativeLibrary becomes the WebAssembly SDK's NativeFileReference, which turns on
    WasmBuildNative; that relink needs the wasm-tools workload. DirectPInvoke is the equivalent
    binding for NativeAOT-LLVM. The archive is ktx.a because the browser-wasm pinvoke table is
    keyed by the native file name, which must match Ktx2.NET's [DllImport("ktx")].

    NuGet imports this into package consumers only. NativeLibrary items do not flow through a
    ProjectReference, so a browser app that builds the engine from source must import this file
    itself; the fallback below then finds the archive in third_party/ktx, where a source
    checkout keeps it (the package keeps it beside this file).
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <ParadiseKtxBrowserWasmArchive Condition="'$(ParadiseKtxBrowserWasmArchive)' == '' and Exists('$(MSBuildThisFileDirectory)browser-wasm/ktx.a')">$(MSBuildThisFileDirectory)browser-wasm/ktx.a</ParadiseKtxBrowserWasmArchive>
    <ParadiseKtxBrowserWasmArchive Condition="'$(ParadiseKtxBrowserWasmArchive)' == ''">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)../../../../third_party/ktx/browser-wasm/ktx.a'))</ParadiseKtxBrowserWasmArchive>
  </PropertyGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <NativeLibrary Include="$(ParadiseKtxBrowserWasmArchive)" />
    <DirectPInvoke Include="ktx" />
  </ItemGroup>

</Project>
