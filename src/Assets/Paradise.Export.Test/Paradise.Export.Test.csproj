<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Export contract round trips and golden fixtures, authored payload routing, matrix order,
    collider scale folding and DotRecast navigation baking. KTX tool tests live in the asset pipeline.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Benign: Microsoft.Testing.Platform ships resource locales the SDK doesn't recognize. -->
    <NoWarn>$(NoWarn);NETSDK1188</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <!-- The document loader takes an IFileSystem; a memory mount is what these read out of. -->
    <PackageReference Include="Zio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paradise.Export\Paradise.Export.csproj" />
    <!-- The test assembly declares its own [Authored] fixtures (the engine declares none since
         contract v6), so it needs the generator the same way a game does. -->
    <ProjectReference Include="..\Paradise.Authoring.Generators\Paradise.Authoring.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden fixtures copied next to the test assembly; each test documents its provenance. -->
    <None Include="Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
