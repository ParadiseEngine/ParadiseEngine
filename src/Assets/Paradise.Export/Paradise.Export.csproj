<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Engine-neutral export and bake tooling, shared by editor hosts (ParadiseGodot today; any future
    Unity/other authoring host) and the asset pipeline: the JSON and TOML document writers and
    DotRecast navmesh baking. The document contract a game reads is Paradise.Export.Contract, which
    this package references, so a host that references Paradise.Export still sees every type.
    NO editor/engine references by design: buildable and testable with plain dotnet.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Ported sources declare all usings explicitly; keep them verbatim. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Title>Paradise.Export</Title>
    <PackageId>Paradise.Export</PackageId>
    <Description>Export and bake tooling for Paradise editor hosts and the asset pipeline: JSON and TOML writers for the document contract (Paradise.Export.Contract) and DotRecast navmesh baking. Not needed by a shipped game. No engine or editor dependency.</Description>
    <PackageTags>export;authoring;navmesh;dotrecast;game-dev</PackageTags>
    <!-- Source-generated System.Text.Json keeps serialization reflection-free. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paradise.Export.Contract\Paradise.Export.Contract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Match the DotRecast version the original ParadiseUnityEditor vendored so the navmesh
         binary format stays identical to what the Paradise runtime expects. -->
    <PackageReference Include="DotRecast.Core" />
    <PackageReference Include="DotRecast.Detour" />
    <PackageReference Include="DotRecast.Recast" />
    <!-- The TOML writer. Untyped model + source-generated context only, so the AOT promise the
         JSON path makes is unchanged. -->
    <PackageReference Include="Tomlyn" />
  </ItemGroup>

</Project>
