<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Seekable, independently compressed Zstandard asset packs exposed as a read-only Zio filesystem.</Description>
    <PackageTags>assets;zstandard;filesystem;zio;nativeaot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Zio" />
    <PackageReference Include="ZstdSharp.Port" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
