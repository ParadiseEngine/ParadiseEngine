<Project>

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Validate XML references while allowing undocumented members and parameters. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Local default for all Paradise packages; keep it current. Release tags override it with -p:Version. -->
    <Version>0.45.1</Version>
  </PropertyGroup>

  <!-- Shared NuGet package metadata. Per-project csproj supplies Description and
       PackageTags; tests/samples/benchmarks/generators opt out via IsPackable=false. -->
  <PropertyGroup>
    <Authors>ParadiseEngine</Authors>
    <Copyright>ParadiseEngine</Copyright>
    <PackageProjectUrl>https://github.com/ParadiseEngine/ParadiseEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ParadiseEngine/ParadiseEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <Link Include="../.editorconfig" />
  </ItemGroup>

  <!-- Enable GPU timestamps, CPU timings and sample benchmarks across the project graph.
       Public timing APIs remain present but report unavailable when disabled. -->
  <PropertyGroup Condition="'$(ParadiseProfiling)' == 'true'">
    <DefineConstants>$(DefineConstants);PARADISE_PROFILING</DefineConstants>
  </PropertyGroup>

</Project>
