<Project>

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- ON so the compiler VALIDATES doc comments: a <see cref="..."/> naming something that no
         longer exists is CS1574, and with warnings-as-errors that breaks the build instead of
         rotting silently. Three dangling crefs were found by hand before this was turned on.
         CS1591/CS1573 (missing comment, missing param tag) are suppressed deliberately: the goal
         is references that RESOLVE, not blanket doc coverage, and requiring the latter across the
         engine would be a different decision made by accident. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The version every Paradise.* package ships as. They are versioned TOGETHER: a consumer
         pins one number (ShiningPie's ParadiseVersion) and gets a set that was built and tested
         against itself, so a partial bump is not a thing anyone can express by accident.

         0.42.0 is the extension path: a game adds its own asset types without editing the engine.
         `[extract]` routes each kind to its own directory by open kind ids importers declare;
         extraction became the importer's other half rather than a second chain; the extraction
         record moved out of `[glb]` into a format-neutral `[extract]` sidecar domain; and the CLI
         loads a project's own importers from `[extensions] assemblies`. A consumer must re-extract
         once against this version — legacy sidecars are migrated on that run, not before. -->
    <Version>0.42.0</Version>
  </PropertyGroup>

  <!-- Shared NuGet package metadata. Per-project csproj supplies Description and
       PackageTags; tests/samples/benchmarks/generators opt out via IsPackable=false. -->
  <PropertyGroup>
    <Authors>ParadiseEngine</Authors>
    <Copyright>ParadiseEngine</Copyright>
    <PackageProjectUrl>https://github.com/ParadiseEngine/ParadiseEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ParadiseEngine/ParadiseEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <Link Include="../.editorconfig" />
  </ItemGroup>

  <!-- dotnet build -p:ParadiseProfiling=true compiles the profiling paths in: per-pass GPU
       timestamps in the WebGPU backend, CPU phase timings in the PBR renderer, the sample's
       bench. A global property reaches every project in the build, so the renderer and the host
       that reads its timings always agree; a define set in one csproj would not. Off, the public
       members stay (a host compiles either way) and report that timing is unavailable. -->
  <PropertyGroup Condition="'$(ParadiseProfiling)' == 'true'">
    <DefineConstants>$(DefineConstants);PARADISE_PROFILING</DefineConstants>
  </PropertyGroup>

</Project>
