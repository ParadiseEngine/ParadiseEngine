<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Paradise.Ui.Noesis</AssemblyName>
    <RootNamespace>Paradise.Ui.Noesis</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Title>Paradise.Ui.Noesis</Title>
    <PackageId>Paradise.Ui.Noesis</PackageId>
    <Description>NoesisGUI (XAML) UI integration for Paradise Engine hosts. Requires a NoesisGUI license for use.</Description>
    <PackageTags>noesis;xaml;ui;webgpu;game-dev</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Noesis.GUI" />
    <!-- XAML, textures and fonts come out of a mount the host chooses, not off a host path. -->
    <PackageReference Include="Zio" />
    <PackageReference Include="WebGPUSharp" />
    <!-- NoesisViewCore implements the shared UI input contract. -->
    <ProjectReference Include="..\Paradise.Ui\Paradise.Ui.csproj" />
  </ItemGroup>
</Project>
