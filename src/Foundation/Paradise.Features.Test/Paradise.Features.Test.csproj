<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Paradise.Features.Test</AssemblyName>
    <RootNamespace>Paradise.Features.Test</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <!-- Test the source-generated settings binder used by games. -->
    <PackageReference Include="Tomlyn" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paradise.Features\Paradise.Features.csproj" />
    <!-- Test the TOML reader against the shared configuration model. -->
    <ProjectReference Include="..\Paradise.Features.Toml\Paradise.Features.Toml.csproj" />
  </ItemGroup>
</Project>
