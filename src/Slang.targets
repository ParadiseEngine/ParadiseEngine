<Project>

  <!--
    Shared Slang-to-WGSL toolchain for projects that supply SlangShader items.
    RestoreSlang builds the standalone helper, verifies the manifest-selected archive and
    installs it under a cross-process cache lock. CompileSlangShaders emits WGSL and reflection
    JSON; _AddSlangEmbeddedResources adds those outputs to the consuming assembly.

    Cache: $(NuGetPackageRoot)_slang/$(SlangVersion)/$(_SlangResolvedRid), or <repo>/.slang-cache
    when NuGetPackageRoot is unset. The cache survives dotnet clean.
    SlangRid overrides the detected build host; the application's RuntimeIdentifier does not
    select the compiler, since cross-compiled targets still need a host-native tool.
  -->

  <PropertyGroup>
    <!-- Sentinel for importers: both the NuGet build/ shim and a workspace source-override may
         try to import this file; they condition on it so the targets are defined exactly once. -->
    <SlangTargetsImported>true</SlangTargetsImported>
    <SlangManifestPath Condition="'$(SlangManifestPath)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/slang/slang.manifest.json'))</SlangManifestPath>
    <SlangBootstrapProject Condition="'$(SlangBootstrapProject)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/slang/SlangBootstrap.csproj'))</SlangBootstrapProject>
    <SlangBootstrapDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/slang'))</SlangBootstrapDir>

    <!-- Manifest version is needed before RestoreSlang runs to compute the cache path. Read it
         directly from the JSON via a regex (XmlPeek isn't applicable to JSON). The "version"
         key currently appears only at the top level; keep it unambiguous if the manifest grows. -->
    <_SlangManifestText>$([System.IO.File]::ReadAllText('$(SlangManifestPath)'))</_SlangManifestText>
    <SlangVersion>$([System.Text.RegularExpressions.Regex]::Match($(_SlangManifestText), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</SlangVersion>
  </PropertyGroup>

  <!-- All three restore-phase targets are gated on the consumer actually owning
       .slang sources: the NuGet shim imports this file into EVERY package consumer, and one
       without shaders must not pay the bootstrap build + slangc download. (The gate must sit on
       each target: MSBuild runs DependsOnTargets before evaluating a target's own condition.) -->
  <Target Name="_ResolveSlangRid" Condition="@(SlangShader-&gt;Count()) &gt; 0">
    <!-- Select the build host, not a target such as browser-wasm; SlangRid is an explicit override. -->
    <PropertyGroup Condition="'$(_SlangResolvedRid)' == ''">
      <_SlangResolvedRid>$(SlangRid)</_SlangResolvedRid>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_SlangResolvedRid)' == ''">
      <_SlangHostOs Condition="$([MSBuild]::IsOSPlatform('Windows'))">win</_SlangHostOs>
      <_SlangHostOs Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_SlangHostOs>
      <_SlangHostOs Condition="'$(_SlangHostOs)' == ''">linux</_SlangHostOs>
      <_SlangHostArch>$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</_SlangHostArch>
      <_SlangHostArch Condition="'$(_SlangHostArch)' == 'x64'">x64</_SlangHostArch>
      <_SlangHostArch Condition="'$(_SlangHostArch)' == 'arm64'">arm64</_SlangHostArch>
      <_SlangResolvedRid>$(_SlangHostOs)-$(_SlangHostArch)</_SlangResolvedRid>
    </PropertyGroup>
  </Target>

  <!-- A project-scoped helper avoids shared dotnet run-file caches. MSBuild coordinates
       repeated references within a build graph; the helper separately locks archive installation. -->
  <Target Name="_BuildSlangBootstrap" DependsOnTargets="_ResolveSlangRid" Condition="@(SlangShader-&gt;Count()) &gt; 0">
    <!-- When the bootstrap project lives inside the NuGet cache (package consumers), its obj/bin
         must land somewhere writable and project-local instead: set SlangBootstrapOutputRoot
         (the package's build/ shim points it at the consumer's IntermediateOutputPath). -->
    <PropertyGroup>
      <_SlangBootstrapProps>Configuration=Release</_SlangBootstrapProps>
      <_SlangBootstrapProps Condition="'$(SlangBootstrapOutputRoot)' != ''">Configuration=Release;BaseIntermediateOutputPath=$(SlangBootstrapOutputRoot)obj/;BaseOutputPath=$(SlangBootstrapOutputRoot)bin/</_SlangBootstrapProps>
    </PropertyGroup>
    <!-- The helper may live outside the consumer's Git roots. Remove application publishing,
         CI source-mapping and restore-time item globals so it builds with its own defaults.
         In particular, EnableDefaultCompileItems=false would hide its entry point, and inherited
         warning escalation would override its console-helper policy. -->
    <MSBuild Projects="$(SlangBootstrapProject)"
             Properties="$(_SlangBootstrapProps)"
             RemoveProperties="TreatWarningsAsErrors;EnableDefaultCompileItems;EnableDefaultEmbeddedResourceItems;EnableDefaultNoneItems;TargetFramework;TargetFrameworks;RuntimeIdentifier;ContinuousIntegrationBuild;DeterministicSourcePaths;PublishAot;PublishTrimmed;SelfContained"
             Targets="Restore" />
    <MSBuild Projects="$(SlangBootstrapProject)"
             Properties="$(_SlangBootstrapProps)"
             RemoveProperties="TreatWarningsAsErrors;EnableDefaultCompileItems;EnableDefaultEmbeddedResourceItems;EnableDefaultNoneItems;TargetFramework;TargetFrameworks;RuntimeIdentifier;ContinuousIntegrationBuild;DeterministicSourcePaths;PublishAot;PublishTrimmed;SelfContained"
             Targets="Build">
      <Output TaskParameter="TargetOutputs" ItemName="_SlangBootstrapAssemblies" />
    </MSBuild>
    <PropertyGroup>
      <_SlangBootstrapAssembly>@(_SlangBootstrapAssemblies->'%(FullPath)')</_SlangBootstrapAssembly>
    </PropertyGroup>
  </Target>

  <Target Name="RestoreSlang"
          DependsOnTargets="_BuildSlangBootstrap"
          BeforeTargets="CollectPackageReferences;CompileSlangShaders;CoreCompile;PrepareResources" Condition="@(SlangShader-&gt;Count()) &gt; 0">

    <PropertyGroup>
      <_SlangCacheRoot Condition="'$(NuGetPackageRoot)' != ''">$(NuGetPackageRoot)_slang</_SlangCacheRoot>
      <_SlangCacheRoot Condition="'$(_SlangCacheRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../.slang-cache'))</_SlangCacheRoot>
      <SlangDir>$([System.IO.Path]::GetFullPath('$(_SlangCacheRoot)/$(SlangVersion)/$(_SlangResolvedRid)'))</SlangDir>
      <_SlangcExeName Condition="$(_SlangResolvedRid.StartsWith('win-'))">slangc.exe</_SlangcExeName>
      <_SlangcExeName Condition="'$(_SlangcExeName)' == ''">slangc</_SlangcExeName>
      <SlangcPath>$(SlangDir)/bin/$(_SlangcExeName)</SlangcPath>
      <!-- Bare `dotnet` is not on PATH when the build is spawned from a GUI process (Godot
           editor, IDEs) even though the parent host was started by absolute path; the host
           exports its own location as DOTNET_HOST_PATH for exactly this. -->
      <_SlangDotNetHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_SlangDotNetHost>
      <_SlangDotNetHost Condition="'$(_SlangDotNetHost)' == ''">dotnet</_SlangDotNetHost>
    </PropertyGroup>

    <Exec Command="&quot;$(_SlangDotNetHost)&quot; &quot;$(_SlangBootstrapAssembly)&quot; --manifest &quot;$(SlangManifestPath)&quot; --rid $(_SlangResolvedRid) --out &quot;$(SlangDir)&quot;"
          ConsoleToMSBuild="true" />

    <Error Condition="!Exists('$(SlangcPath)')"
           Text="slangc not found at '$(SlangcPath)' after RestoreSlang. Check tools/slang/slang.manifest.json for RID '$(_SlangResolvedRid)'." />
  </Target>

  <Target Name="_CollectSlangShaderInputs" Condition="@(SlangShader-&gt;Count()) &gt; 0">
    <!-- Include search paths may be supplied by a package shim or source override imported after
         this file. Collect them at execution time so engine layout changes invalidate game shaders. -->
    <ItemGroup Condition="'@(SlangIncludeDir)' != ''">
      <_SlangSearchPathInclude Include="%(SlangIncludeDir.FullPath)/**/*.slang" />
    </ItemGroup>
    <PropertyGroup>
      <_SlangInputManifest>$(IntermediateOutputPath)shaders/inputs.cache</_SlangInputManifest>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)shaders" />
    <!-- A package/source switch can select older files. Record input identities as well as checking
         timestamps, so switching include roots or adding/removing an include cannot reuse old output. -->
    <WriteLinesToFile File="$(_SlangInputManifest)"
                      Lines="$(SlangcPath);@(SlangShader-&gt;'%(FullPath)');@(SlangShaderInclude-&gt;'%(FullPath)');@(SlangIncludeDir-&gt;'%(FullPath)');@(_SlangSearchPathInclude-&gt;'%(FullPath)')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="CompileSlangShaders"
          DependsOnTargets="RestoreSlang;_CollectSlangShaderInputs"
          BeforeTargets="BeforeBuild;PrepareResources;PrepareResourceNames"
          Condition="@(SlangShader-&gt;Count()) &gt; 0"
          Inputs="@(SlangShader);@(SlangShaderInclude);@(_SlangSearchPathInclude);$(_SlangInputManifest);$(SlangManifestPath);$(MSBuildAllProjects)"
          Outputs="@(SlangShader-&gt;'$(IntermediateOutputPath)shaders/%(Filename).wgsl');@(SlangShader-&gt;'$(IntermediateOutputPath)shaders/%(Filename).reflection.json');@(SlangShader-&gt;'$(IntermediateOutputPath)shaders/%(Filename).raw-reflection.json')">

    <PropertyGroup>
      <_SlangOutputDir>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)shaders'))</_SlangOutputDir>
    </PropertyGroup>

    <!-- Output names use %(Filename), so entry-point shaders must have unique basenames even
         in different source directories. Duplicate basenames overwrite the same compiled output. -->

    <MakeDir Directories="$(_SlangOutputDir)" />

    <!-- Include directories become -I search paths after the including file's own directory.
         Trim a trailing directory separator: on Windows, the final backslash would escape the
         argument's closing quote and absorb subsequent arguments. -->
    <ItemGroup>
      <_SlangIncludeArg Include="@(SlangIncludeDir)">
        <SearchPath>$([System.IO.Path]::TrimEndingDirectorySeparator('%(FullPath)'))</SearchPath>
      </_SlangIncludeArg>
    </ItemGroup>

    <Exec Command="&quot;$(SlangcPath)&quot; &quot;%(SlangShader.FullPath)&quot; @(_SlangIncludeArg-&gt;'-I &quot;%(SearchPath)&quot;', ' ') -target wgsl -o &quot;$(_SlangOutputDir)/%(SlangShader.Filename).wgsl&quot; -reflection-json &quot;$(_SlangOutputDir)/%(SlangShader.Filename).reflection.json&quot;"
          ConsoleToMSBuild="true" />

    <!-- Keep a separately named raw-reflection resource for compiler-contract golden tests.
         The runtime loader currently transforms the raw JSON, so these two resources are identical. -->
    <Copy SourceFiles="@(SlangShader-&gt;'$(_SlangOutputDir)/%(Filename).reflection.json')"
          DestinationFiles="@(SlangShader-&gt;'$(_SlangOutputDir)/%(Filename).raw-reflection.json')"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    Correct the pinned compiler's shadow-map declaration and scalar loads for WGSL comparison
    sampling: shadowTexture must be texture_depth_2d_array rather than texture_2d_array<f32>.
    The textual guard rejects comparison-sampling output with no texture_depth_2d_array text;
    it does not prove that every comparison call uses a patched shadow texture.
  -->
  <UsingTask TaskName="PatchShadowDepthTextureWgsl"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <WgslFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (File.Exists(WgslFile))
        {
            var code = File.ReadAllText(WgslFile);
            var patched = Regex.Replace(code,
                @"(var\s+shadowTexture(?:_\d+)?\s*:\s*)texture_2d_array<f32>",
                "$1texture_depth_2d_array");
            // A sampled texture load yields vec4, but a depth load yields f32. Slang emits
            // .x for Texture2DArray<float>; remove it only from this patched texture's loads.
            for (var start = patched.IndexOf("textureLoad(", StringComparison.Ordinal); start >= 0;
                 start = patched.IndexOf("textureLoad(", start + 1, StringComparison.Ordinal))
            {
                var end = start + "textureLoad".Length;
                var nesting = 0;
                do
                {
                    if (patched[end] == '(') nesting++;
                    if (patched[end] == ')') nesting--;
                    end++;
                } while (end < patched.Length && nesting > 0);
                var comma = patched.IndexOf(',', start);
                if (comma > start && comma < end &&
                    Regex.IsMatch(patched.Substring(start, comma - start), @"\bshadowTexture(?:_\d+)?\b") &&
                    end + 1 < patched.Length && patched[end] == '.' && patched[end + 1] == 'x')
                    patched = patched.Remove(end, 2);
            }
            if (patched.Contains("textureSampleCompareLevel(") && !patched.Contains("texture_depth_2d_array"))
                throw new Exception("Shadow comparison sampling present but no texture_depth_2d_array shadow texture after patch: " + WgslFile);
            if (patched != code)
                File.WriteAllText(WgslFile, patched);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="_PatchShadowDepthTextureWgsl"
          DependsOnTargets="CompileSlangShaders"
          BeforeTargets="_AddSlangEmbeddedResources"
          Condition="@(SlangShader-&gt;Count()) &gt; 0">
    <PropertyGroup>
      <_SlangOutputDir>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)shaders'))</_SlangOutputDir>
    </PropertyGroup>
    <PatchShadowDepthTextureWgsl WgslFile="$(_SlangOutputDir)/%(SlangShader.Filename).wgsl" />
  </Target>

  <!--
    Promote the compiled outputs to <EmbeddedResource>. Runs ahead of PrepareResourceNames so the
    items are visible to the resource embedding pipeline. The Inputs/Outputs gate on
    CompileSlangShaders keeps slangc itself incremental; this target is cheap on every build.
  -->
  <Target Name="_AddSlangEmbeddedResources"
          DependsOnTargets="CompileSlangShaders"
          BeforeTargets="PrepareResourceNames;AssignTargetPaths"
          Condition="@(SlangShader-&gt;Count()) &gt; 0">
    <ItemGroup>
      <EmbeddedResource Include="@(SlangShader-&gt;'$(IntermediateOutputPath)shaders/%(Filename).wgsl')">
        <LogicalName>Shaders.%(Filename).wgsl</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="@(SlangShader-&gt;'$(IntermediateOutputPath)shaders/%(Filename).reflection.json')">
        <LogicalName>Shaders.%(Filename).reflection.json</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="@(SlangShader-&gt;'$(IntermediateOutputPath)shaders/%(Filename).raw-reflection.json')">
        <LogicalName>Shaders.%(Filename).raw-reflection.json</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
