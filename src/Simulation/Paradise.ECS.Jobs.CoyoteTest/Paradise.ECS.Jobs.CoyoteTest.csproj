<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Paradise.ECS.Common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Standalone systematic runner, intentionally not an IsTestProject. -->
    <NoWarn>$(NoWarn);CA1707;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Coyote.Test" />
    <ProjectReference Include="..\Paradise.ECS.Jobs\Paradise.ECS.Jobs.csproj" />
    <None Include="coyote-rewrite.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CoyoteRewrite" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="coyote rewrite $(TargetDir)coyote-rewrite.json" />
  </Target>

</Project>
