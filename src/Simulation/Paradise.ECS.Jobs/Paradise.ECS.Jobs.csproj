<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Paradise.ECS.Common.props" />

  <PropertyGroup>
    <!--
      The jobs runtime targets net10.0 alongside the ECS runtime it references.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <Title>Paradise.ECS.Jobs</Title>
    <PackageId>Paradise.ECS.Jobs</PackageId>
    <Description>Parallel ECS wave scheduling on the shared Paradise.Jobs worker pools: dependency-tracked system jobs with deterministic execution.</Description>
    <PackageTags>ecs;jobs;parallel;scheduling;nativeaot;game-dev</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Paradise.ECS.Jobs.Test" />
    <InternalsVisibleTo Include="Paradise.ECS.Jobs.CoyoteTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paradise.ECS\Paradise.ECS.csproj" />
    <ProjectReference Include="..\..\Foundation\Paradise.Jobs\Paradise.Jobs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Paradise.ECS" />
    <Using Include="Paradise.Jobs" />
  </ItemGroup>

</Project>
