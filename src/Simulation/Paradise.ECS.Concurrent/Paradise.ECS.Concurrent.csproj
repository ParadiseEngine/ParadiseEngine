<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Paradise.ECS.Common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Title>Paradise.ECS.Concurrent</Title>
    <PackageId>Paradise.ECS.Concurrent</PackageId>
    <Description>EXPERIMENTAL. A separate, lock-based archetype world that accepts structural changes from several threads. It shares Paradise.ECS component types but not its World: it cannot run SystemSchedule, compose with tag or managed worlds, or snapshot. Using it reports PECS9000.</Description>
    <PackageTags>ecs;concurrency;command-buffer;nativeaot;game-dev</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Paradise.ECS.Concurrent.Test" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paradise.ECS\Paradise.ECS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Paradise.ECS" />
  </ItemGroup>

</Project>
