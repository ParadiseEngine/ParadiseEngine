<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1001;IDE0005</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paradise.Animation\Paradise.Animation.csproj" />
    <ProjectReference Include="..\..\Assets\Paradise.Assets.Gltf\Paradise.Assets.Gltf.csproj" />
    <ProjectReference Include="..\..\Assets\Paradise.Assets.Pipeline\Paradise.Assets.Pipeline.csproj" />
  </ItemGroup>

  <!-- Share test-only glTF helpers without shipping them in the runtime. -->
  <ItemGroup>
    <Compile Include="..\..\Assets\Paradise.Assets.Pipeline.Test\GltfAnimationRig.cs" Link="Borrowed\GltfAnimationRig.cs" />
    <Compile Include="..\..\Assets\Paradise.Assets.Gltf.Test\GlbTestBuilder.cs" Link="Borrowed\GlbTestBuilder.cs" />
  </ItemGroup>

</Project>
