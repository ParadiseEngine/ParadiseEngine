<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Paradise.Editor.Test</AssemblyName>
    <RootNamespace>Paradise.Editor.Test</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project stands in for a HOST: it is the layer allowed to pick a sink, which
         is what lets these tests assert on what the editor reported. No Paradise.Editor.* project
         may reference this. -->
    <ProjectReference Include="../Paradise.Diagnostics/Paradise.Diagnostics.csproj" />
    <ProjectReference Include="../Paradise.Editor.Core/Paradise.Editor.Core.csproj" />
    <ProjectReference Include="../Paradise.Editor.ImGui/Paradise.Editor.ImGui.csproj" />
    <!-- ReferenceOutputAssembly=false: the plugin's types must NOT be visible to these tests. They
         have to arrive through ExtensionCatalog or not at all, which is the only way the test can
         tell a working loader from a compile-time reference. The reference exists solely to order
         the build; the target below puts the output where the loader will look. -->
    <ProjectReference Include="../Paradise.Editor.TestPlugin/Paradise.Editor.TestPlugin.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="StageTestPlugin" AfterTargets="Build">
    <ItemGroup>
      <TestPluginOutput Include="$(MSBuildThisFileDirectory)../Paradise.Editor.TestPlugin/bin/$(Configuration)/$(TargetFramework)/Paradise.Editor.TestPlugin.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(TestPluginOutput)" DestinationFolder="$(OutDir)plugins" SkipUnchangedFiles="true" />
  </Target>

</Project>
