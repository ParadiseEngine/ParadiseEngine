<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Paradise.Ui.ImGui</AssemblyName>
    <RootNamespace>Paradise.Ui.ImGui</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <Title>Paradise.Ui.ImGui</Title>
    <PackageId>Paradise.Ui.ImGui</PackageId>
    <Description>Dear ImGui overlay integration for Paradise Engine: the sim-thread ImGui core, cross-thread draw snapshots and the 1.92 texture protocol, rendered through the WebGPU backend. Built on Hexa.NET.ImGui.</Description>
    <PackageTags>imgui;ui;overlay;webgpu;game-dev</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hexa.NET.ImGui" />
    <!-- Fonts come out of a mount the host chooses, not off a host path. -->
    <PackageReference Include="Zio" />
    <PackageReference Include="WebGPUSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- IUiInput / WindowEvent: the ImGui core is one implementation of the engine's UI input
         contract, stackable with the others through CompositeUiInput. -->
    <ProjectReference Include="..\Paradise.Ui\Paradise.Ui.csproj" />
  </ItemGroup>
</Project>
