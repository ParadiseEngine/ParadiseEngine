<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The STANDALONE host: it owns the window, the GPU device, the ImGui frame and the loop, and
    calls the editor's draw inside that frame. The in-game host owns those already and calls the
    same draw from its own frame, which is why nothing below this project is allowed to reach for
    a window or a device — see Paradise.Editor.ImGui's csproj.
  -->
  <PropertyGroup>
    <AssemblyName>Paradise.Editor.Host</AssemblyName>
    <RootNamespace>Paradise.Editor.Host</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <!--
      Packs as a dotnet tool, the same way Paradise.Cli does: `dotnet tool install -g
      Paradise.Editor.Host` then `paradise-editor`. Framework-dependent and RID-agnostic, so one
      package serves every desktop — the Dawn, SDL and cimgui natives ride along in runtimes/ and
      the host resolves the right ones from deps.json at startup.
    -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>paradise-editor</ToolCommandName>
    <PackageId>Paradise.Editor.Host</PackageId>
    <Title>Paradise.Editor.Host</Title>
    <Description>The standalone Paradise editor: an SDL window, a WebGPU device and the editor shell drawn into it. Installs as a dotnet tool and runs as `paradise-editor`; `--frames N --screenshot PATH` renders offscreen instead, for a machine with no display.</Description>
    <PackageTags>editor;tooling;dotnet-tool;game-dev</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Paradise.Editor.Core/Paradise.Editor.Core.csproj" />
    <ProjectReference Include="../Paradise.Editor.ImGui/Paradise.Editor.ImGui.csproj" />
    <ProjectReference Include="../Paradise.Rendering.WebGPU/Paradise.Rendering.WebGPU.csproj" />
    <ProjectReference Include="../Paradise.Ui.ImGui/Paradise.Ui.ImGui.csproj" />
    <ProjectReference Include="../Paradise.Windowing.Sdl/Paradise.Windowing.Sdl.csproj" />
    <!-- A host picks the sink. Engine libraries take an ILogger and name none; this is the one
         layer entitled to decide where their diagnostics go (docs/logging.md). -->
    <ProjectReference Include="../Paradise.Diagnostics/Paradise.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fonts and the layout ini come out of a mount the host chooses. -->
    <PackageReference Include="Zio" />
  </ItemGroup>

  <!--
    Mobile natives are dead weight in a desktop editor's package. SDL3 and cimgui ship
    android-arm64/x64/x86 and iOS builds, and Dawn ships more besides; together they were ~57 MB of
    a 231 MB package for platforms this executable cannot run on — it needs a desktop window and a
    desktop GPU. Removed from what gets published rather than from the PackageReferences, because
    the packages are right to carry them and other consumers may want them.
  -->
  <Target Name="TrimNonDesktopRuntimes" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('runtimes/android')) Or
                   $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('runtimes/ios')) Or
                   $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('runtimes/maccatalyst')) Or
                   $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('runtimes/browser')) Or
                   $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('runtimes/tvos'))" />
    </ItemGroup>
  </Target>

</Project>
