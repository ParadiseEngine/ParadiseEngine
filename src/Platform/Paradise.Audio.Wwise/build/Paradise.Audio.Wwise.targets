<Project>

  <!--
    Builds and stages libParadiseWwise into the consuming app's output.

    NuGet imports this automatically for any project that references Paradise.Audio.Wwise; the
    workspace-local source override imports it by hand, because a ProjectReference does not carry
    a package's build/ targets.

    The package ships the MIT shim source without Wwise SDK libraries. Consumers build against
    their own licensed SDK; the resulting library is staged with the app. This target currently
    stages the macOS dylib, although build.sh also has a Linux build path.

    When SDK discovery fails, warn and skip native compilation so hosts can run without audio.
    Once a usable SDK is found, native build failures propagate through Exec.

    Keep discovery, compilation and staging in one target so each guard reads the properties
    established by the preceding steps.

    Opt out entirely with -p:ParadiseWwiseEnabled=false.
  -->

  <PropertyGroup>
    <ParadiseWwiseEnabled Condition="'$(ParadiseWwiseEnabled)' == ''">true</ParadiseWwiseEnabled>

    <!-- Profile enables optimized audio with profiler communication; Debug also supports the
         profiler, while Release compiles communication out. See native/wwise/build.sh. -->
    <ParadiseWwiseConfig Condition="'$(ParadiseWwiseConfig)' == ''">Profile</ParadiseWwiseConfig>

    <!-- Two layouts to satisfy: inside the restored package (build/ and native/ are siblings),
         and inside the engine checkout, where this file sits at src/Platform/Paradise.Audio.Wwise/build/
         and the sources are at native/wwise/ off the repo root. -->
    <_ParadiseWwiseNativeDir Condition="Exists('$(MSBuildThisFileDirectory)../native/wwise/build.sh')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../native/wwise'))</_ParadiseWwiseNativeDir>
    <_ParadiseWwiseNativeDir Condition="'$(_ParadiseWwiseNativeDir)' == '' AND Exists('$(MSBuildThisFileDirectory)../../../../native/wwise/build.sh')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../../native/wwise'))</_ParadiseWwiseNativeDir>
  </PropertyGroup>

  <Target Name="ParadiseWwiseNative"
          BeforeTargets="AssignTargetPaths"
          Condition="'$(ParadiseWwiseEnabled)' == 'true'">

    <!--
      Does this project actually use audio?

      NuGet only imports this file for projects that reference the package, so the answer is
      always yes on that path. The workspace source override imports it for EVERY project it
      touches — MSBuild forbids item references in an Import condition — so the check lives here
      instead, where items are legal. Without it, a test project with no audio would still build
      and stage a native dylib it never loads.

      Matched through an ItemGroup with %(Identity) batching rather than a string function over
      @(ProjectReference): MSBuild does not expand item lists inside property-function arguments,
      so the obvious one-liner silently evaluates to false and audio never builds.
    -->
    <ItemGroup>
      <_ParadiseWwiseRef Include="@(ProjectReference)"
                         Condition="$([System.String]::Copy('%(Identity)').Contains('Paradise.Audio.Wwise'))" />
    </ItemGroup>

    <PropertyGroup>
      <_WwiseReferenced Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Paradise.Audio.Wwise')) == 'true'">true</_WwiseReferenced>
      <_WwiseReferenced Condition="'@(_ParadiseWwiseRef)' != ''">true</_WwiseReferenced>

      <_WwiseSdkRoot Condition="'$(WwiseSdkRoot)' != ''">$(WwiseSdkRoot)</_WwiseSdkRoot>
      <_WwiseSdkRoot Condition="'$(_WwiseSdkRoot)' == ''">$(WWISESDK)</_WwiseSdkRoot>
    </PropertyGroup>

    <!-- Probe installed SDK headers through an item glob. Unlike build.sh's sort -V fallback,
         this path has no explicit version sort; set WwiseSdkRoot to choose a specific install. -->
    <ItemGroup Condition="'$(_WwiseReferenced)' == 'true' AND '$(_WwiseSdkRoot)' == ''">
      <_WwiseCandidate Include="/Applications/Audiokinetic/Wwise_*/SDK/include/AK/SoundEngine/Common/AkSoundEngine.h" />
    </ItemGroup>
    <PropertyGroup Condition="'$(_WwiseSdkRoot)' == '' AND '@(_WwiseCandidate)' != ''">
      <_WwiseNewestHeader>%(_WwiseCandidate.FullPath)</_WwiseNewestHeader>
      <!-- Five levels up from .../SDK/include/AK/SoundEngine/Common/AkSoundEngine.h is the SDK
           root. Six would be the Wwise install, whose include/ does not exist — and the Exists()
           guard below would then quietly disable audio. -->
      <_WwiseSdkRoot>$([System.IO.Path]::GetFullPath('$(_WwiseNewestHeader)/../../../../..'))</_WwiseSdkRoot>
    </PropertyGroup>

    <PropertyGroup>
      <_WwiseUsable Condition="'$(_WwiseReferenced)' == 'true' AND '$(_ParadiseWwiseNativeDir)' != '' AND '$(_WwiseSdkRoot)' != '' AND Exists('$(_WwiseSdkRoot)/include/AK/SoundEngine/Common/AkSoundEngine.h')">true</_WwiseUsable>

      <!-- Key the cache on SDK folder name + config: switching either must produce a different
           artifact rather than silently reusing the previous one. -->
      <_WwiseSdkTag Condition="'$(_WwiseUsable)' == 'true'">$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('$(_WwiseSdkRoot)'))))</_WwiseSdkTag>
      <_WwiseCacheRoot Condition="'$(NuGetPackageRoot)' != ''">$(NuGetPackageRoot)_paradise_wwise</_WwiseCacheRoot>
      <_WwiseCacheRoot Condition="'$(_WwiseCacheRoot)' == ''">$(MSBuildProjectDirectory)/obj/paradise_wwise</_WwiseCacheRoot>
      <ParadiseWwiseOutputDir>$([System.IO.Path]::GetFullPath('$(_WwiseCacheRoot)/$(_WwiseSdkTag)/$(ParadiseWwiseConfig)'))</ParadiseWwiseOutputDir>
      <ParadiseWwiseLibrary>$(ParadiseWwiseOutputDir)/libParadiseWwise.dylib</ParadiseWwiseLibrary>
    </PropertyGroup>

    <Warning Condition="'$(_WwiseReferenced)' == 'true' AND '$(_WwiseUsable)' != 'true'"
             Text="Wwise SDK not found — building without audio. Install it via the Audiokinetic Launcher, or set WwiseSdkRoot/WWISESDK. The game runs silent; nothing else is affected. Silence this with -p:ParadiseWwiseEnabled=false." />

    <!-- build.sh is itself incremental (it compares the dylib against our sources and exits
         early), so this runs unconditionally rather than through Inputs/Outputs, which would
         have to be declared on the target and would then also gate the staging below. -->
    <Exec Condition="'$(_WwiseUsable)' == 'true'"
          Command="sh &quot;$(_ParadiseWwiseNativeDir)/build.sh&quot; --out &quot;$(ParadiseWwiseOutputDir)&quot; --config $(ParadiseWwiseConfig) --sdk &quot;$(_WwiseSdkRoot)&quot;"
          ConsoleToMSBuild="true" />

    <!-- Staged as Content rather than by a <Copy> so that `dotnet publish` takes it too — a
         publish that drops the native half produces an app which builds, launches, and is
         inexplicably silent. -->
    <ItemGroup Condition="'$(_WwiseUsable)' == 'true' AND Exists('$(ParadiseWwiseLibrary)')">
      <Content Include="$(ParadiseWwiseLibrary)">
        <Link>libParadiseWwise.dylib</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>

</Project>
