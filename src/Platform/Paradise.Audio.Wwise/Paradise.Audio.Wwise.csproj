<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Paradise.Audio.Wwise</AssemblyName>
    <RootNamespace>Paradise.Audio.Wwise</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Title>Paradise.Audio.Wwise</Title>
    <PackageId>Paradise.Audio.Wwise</PackageId>
    <Description>Audiokinetic Wwise audio integration for Paradise Engine hosts. Managed bindings only — requires a Wwise licence and a local Wwise SDK install, from which the native shim is built.</Description>
    <PackageTags>wwise;audio;game-dev</PackageTags>
  </PropertyGroup>

  <!--
    Pack the MIT shim source and build targets, not Wwise SDK libraries or a prebuilt shim.
    Consumers compile against their own licensed SDK installation.
  -->
  <ItemGroup>
    <None Include="build/Paradise.Audio.Wwise.targets" Pack="true" PackagePath="build/" />
    <None Include="../../../native/wwise/ParadiseWwise.cpp" Pack="true" PackagePath="native/wwise/" />
    <None Include="../../../native/wwise/ParadiseWwise.h" Pack="true" PackagePath="native/wwise/" />
    <None Include="../../../native/wwise/build.sh" Pack="true" PackagePath="native/wwise/" />
  </ItemGroup>
</Project>
