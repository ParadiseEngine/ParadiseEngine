<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Paradise.Audio</PackageId>
    <Title>Paradise.Audio</Title>
    <Description>Backend-agnostic audio contract: event playback on emitters, listeners, parameters, switches, states and content banks, in the engine's coordinate convention. Implemented by Paradise.Audio.* backends (Wwise today); NullAudioEngine plays nothing for hosts without audio.</Description>
    <PackageTags>audio;sound;nativeaot;game-dev</PackageTags>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Paradise.Audio.Test" />
  </ItemGroup>

</Project>
