<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Paradise.Ui.ImGui.Test</AssemblyName>
    <RootNamespace>Paradise.Ui.ImGui.Test</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <!-- Font fixtures mount memory rather than land on disk. -->
    <PackageReference Include="Zio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paradise.Ui.ImGui\Paradise.Ui.ImGui.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fails GPU tests instead of skipping them when PARADISE_REQUIRE_GPU=1 (the CI GPU lane). -->
    <Compile Include="$(MSBuildThisFileDirectory)../../Shared/GpuRequirement.cs" Link="Shared/GpuRequirement.cs" />
    <Using Include="Paradise.Testing" />
  </ItemGroup>

</Project>
