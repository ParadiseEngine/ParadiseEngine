<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The editor's panels and shell as a DRAW-INTO-YOUR-FRAME library. It never calls NewFrame or
    Render, never owns a window, never pumps input: the host runs the ImGui frame and calls
    IEditorShell.Draw inside it. Standalone, that host is Paradise.Editor.Host. In-game, it is
    the game's existing ImGui overlay, so the editor draws inside the game's own draw delegate on
    whichever thread runs that frame. That is what makes one editor serve both hosts.
  -->
  <PropertyGroup>
    <AssemblyName>Paradise.Editor.ImGui</AssemblyName>
    <RootNamespace>Paradise.Editor.ImGui</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- The binding DIRECTLY, not through Paradise.Ui.ImGui. That package owns the frame, the
         input pump and a WebGPU backend — everything the comment above says this library never
         touches — so referencing it to obtain the binding would put the whole renderer behind a
         boundary that has no other way to be enforced. Paradise.Editor.Test guards it. -->
    <PackageReference Include="Hexa.NET.ImGui" />
    <!-- Its own native, its own GImGui: see EditorGizmo.Attach. -->
    <PackageReference Include="Hexa.NET.ImGuizmo" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Paradise.Editor.Core/Paradise.Editor.Core.csproj" />
    <!-- UiFonts and the font-loading path. NOT the frame, the window or the renderer: the guard
         in Paradise.Editor.Test checks the runtime types stay out of this assembly's references,
         and Paradise.Ui.ImGui is not among them because a font loader is not a frame. -->
    <ProjectReference Include="../Paradise.Ui.ImGui/Paradise.Ui.ImGui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded rather than files beside the executable: an editor that will not start because
         somebody moved the binary is shipping a dependency, not a font. See Fonts/README.md for
         the licences and for how these were instanced and subset. -->
    <EmbeddedResource Include="Fonts/Inter-Regular.ttf" />
    <EmbeddedResource Include="Fonts/MaterialSymbolsRounded-Editor.ttf" />
    <!-- The name-to-codepoint map EditorIcons was generated from. Embedded so a test can check the
         two have not drifted from anywhere, rather than only from a checkout. -->
    <EmbeddedResource Include="Fonts/icon-map.txt" />
  </ItemGroup>
</Project>
