<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A real extension assembly, built so ExtensionCatalog has something real to load. Testing a
    plugin loader without a plugin tests the error paths and nothing else — in particular it would
    never catch the assembly-context mistake that makes a plugin's IShellExtension a DIFFERENT type
    from the host's, which is the failure this whole file exists to prove does not happen.

    Not packed, not in the publish list, and referenced by the test project with
    ReferenceOutputAssembly=false so its types are NOT visible to the tests — they have to come
    through the loader or not at all.
  -->
  <PropertyGroup>
    <AssemblyName>Paradise.Editor.TestPlugin</AssemblyName>
    <RootNamespace>Paradise.Editor.TestPlugin</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Paradise.Editor.ImGui/Paradise.Editor.ImGui.csproj" />
  </ItemGroup>

</Project>
