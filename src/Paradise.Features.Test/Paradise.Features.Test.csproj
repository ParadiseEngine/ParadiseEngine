<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Paradise.Features.Test</AssemblyName>
    <RootNamespace>Paradise.Features.Test</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paradise.Features\Paradise.Features.csproj" />
    <!-- The reader is a separate assembly (see its csproj); its tests live here rather than in a
         project of their own, because what they check is the model this one owns. -->
    <ProjectReference Include="..\Paradise.Features.Toml\Paradise.Features.Toml.csproj" />
  </ItemGroup>
</Project>
