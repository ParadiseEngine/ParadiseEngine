<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Intentionally NOT an IsTestProject — a standalone Coyote runner with its own Main, not a
      TUnit suite. Marking it IsTestProject makes `dotnet test` try to host it under
      Microsoft.Testing.Platform, which it does not support. Run it with `dotnet run`.
    -->
    <NoWarn>$(NoWarn);CA1707;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Coyote.Test" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paradise.Assets.Project\Paradise.Assets.Project.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="coyote-rewrite.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Coyote Rewriting: rewrite binaries after build for systematic testing (Release only; requires coyote CLI) -->
  <Target Name="CoyoteRewrite" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="coyote rewrite $(TargetDir)coyote-rewrite.json" />
  </Target>

</Project>
