<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <RootNamespace>Paradise.Rendering.Sample</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- A sample is a host, so it picks a sink — that is the point of the seam (issue #232).
         Without this the renderer's Dawn errors would go nowhere and the sample would be
         quieter than it used to be, which is the regression the wiring below prevents. -->
    <ProjectReference Include="../Paradise.Diagnostics/Paradise.Diagnostics.csproj" />
    <ProjectReference Include="../Paradise.Rendering/Paradise.Rendering.csproj" />
    <ProjectReference Include="../Paradise.Windowing/Paradise.Windowing.csproj" />
    <ProjectReference Include="../Paradise.Rendering.WebGPU/Paradise.Rendering.WebGPU.csproj" />
    <ProjectReference Include="../Paradise.Rendering.Pbr/Paradise.Rendering.Pbr.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" />
    <!-- The GLB's directory is mounted, and the mount is what confines its texture uris. -->
    <PackageReference Include="Zio" />
  </ItemGroup>

  <Import Project="../Slang.targets" />

  <ItemGroup>
    <SlangShader Include="Shaders/**/*.slang" />
  </ItemGroup>

</Project>
