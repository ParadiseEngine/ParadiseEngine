<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Paradise.Rendering.Browser.Sample</RootNamespace>
    <!-- Enable runtime preload/importmap placeholders. The importmap resolves fingerprinted framework
         assets; _content shim URLs remain stable. -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host sends engine diagnostics to the browser console. -->
    <ProjectReference Include="../Paradise.Diagnostics/Paradise.Diagnostics.csproj" />
    <ProjectReference Include="../Paradise.Rendering/Paradise.Rendering.csproj" />
    <ProjectReference Include="../Paradise.Rendering.Browser/Paradise.Rendering.Browser.csproj" />
    <ProjectReference Include="../Paradise.Rendering.Pbr/Paradise.Rendering.Pbr.csproj" />
  </ItemGroup>

  <Import Project="../Slang.targets" />

  <ItemGroup>
    <SlangShader Include="Shaders/**/*.slang" />
  </ItemGroup>

</Project>
