<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Native tray icons for `paradise assets watch`. Win32 Shell_NotifyIcon and AppKit
    NSStatusItem live HERE, not in Paradise.Cli, so the console tool's project does not
    grow OS-specific P/Invoke. The CLI talks to this assembly only through IWatchTray;
    PackAsTool still ships the DLL inside the tool package. Linux, CI, and the no-tray
    flag never start a native icon (see WatchTray.IsLikelyAvailable).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Paradise.Cli.Tray</AssemblyName>
    <RootNamespace>Paradise.Cli</RootNamespace>
    <IsPackable>false</IsPackable>
    <Description>Native tray icon for paradise assets watch. Not a separate NuGet; packed inside Paradise.Cli.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The CLI assembly is named `paradise` (ToolCommandName), not Paradise.Cli. -->
    <InternalsVisibleTo Include="paradise" />
    <InternalsVisibleTo Include="Paradise.Cli.Test" />
  </ItemGroup>

</Project>
