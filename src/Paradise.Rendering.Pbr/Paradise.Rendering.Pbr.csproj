<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Paradise.Rendering.Pbr</AssemblyName>
    <RootNamespace>Paradise.Rendering.Pbr</RootNamespace>
    <PackageId>Paradise.Rendering.Pbr</PackageId>
    <Title>Paradise.Rendering.Pbr</Title>
    <Authors>ParadiseEngine</Authors>
    <Description>PBR metallic-roughness scene renderer: Slang-compiled Cook-Torrance shader with reflection-validated uniforms, GLB mesh upload, KTX2 material cache, and a per-frame command-stream emitter. Backend-agnostic — drives any Paradise.Rendering IRenderer implementation; the host picks and supplies the backend.</Description>
    <Copyright>ParadiseEngine</Copyright>
    <PackageProjectUrl>https://github.com/ParadiseEngine/ParadiseEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ParadiseEngine/ParadiseEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>pbr;rendering;webgpu;gltf;nativeaot;game-dev</PackageTags>
    <!-- AOT-clean: reflection-validated uniforms are explicit offset tables, not System.Reflection. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)../Slang.targets" />

  <ItemGroup>
    <!-- Compile entry-point files only; shared includes are inputs that trigger dependent rebuilds. -->
    <SlangShader Include="Shaders/*.slang" />
    <SlangShaderInclude Include="Shaders/Common/**/*.slang" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hosts explicitly reference and provide an IRenderer backend; PBR has no concrete backend
         dependency. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <ProjectReference Include="..\Paradise.Rendering\Paradise.Rendering.csproj" />
    <ProjectReference Include="..\Paradise.Geometry\Paradise.Geometry.csproj" />
    <ProjectReference Include="..\Paradise.Assets.Gltf\Paradise.Assets.Gltf.csproj" />
    <ProjectReference Include="..\Paradise.Assets.Textures\Paradise.Assets.Textures.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Paradise.Rendering.Pbr.Test" />
  </ItemGroup>

  <ItemGroup>
    <!-- Package shader sources and Slang tooling for game extensions; the build target adds their
         include path. -->
    <!-- NuGet appends the glob's recursive dir itself, so the path is the bare folder. -->
    <None Include="Shaders/**/*.slang" Pack="true" PackagePath="shaders" />
    <None Include="build/Paradise.Rendering.Pbr.targets" Pack="true" PackagePath="build/" />
    <None Include="$(MSBuildThisFileDirectory)../Slang.targets" Pack="true" PackagePath="build/Slang.targets" />
    <None Include="$(MSBuildThisFileDirectory)../../tools/slang/slang.manifest.json" Pack="true" PackagePath="tools/slang/" />
    <None Include="$(MSBuildThisFileDirectory)../../tools/slang/SlangBootstrap.cs" Pack="true" PackagePath="tools/slang/" />
    <None Include="$(MSBuildThisFileDirectory)../../tools/slang/SlangBootstrap.csproj" Pack="true" PackagePath="tools/slang/" />
  </ItemGroup>

</Project>
