<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Paradise.Rendering.Pbr</AssemblyName>
    <RootNamespace>Paradise.Rendering.Pbr</RootNamespace>
    <PackageId>Paradise.Rendering.Pbr</PackageId>
    <Title>Paradise.Rendering.Pbr</Title>
    <Authors>ParadiseEngine</Authors>
    <Description>PBR metallic-roughness scene renderer: Slang-compiled Cook-Torrance shader with reflection-validated uniforms, GLB mesh upload, KTX2 material cache, and a per-frame command-stream emitter. Backend-agnostic — drives any Paradise.Rendering IRenderer implementation; the host picks and supplies the backend.</Description>
    <Copyright>ParadiseEngine</Copyright>
    <PackageProjectUrl>https://github.com/ParadiseEngine/ParadiseEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ParadiseEngine/ParadiseEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>pbr;rendering;webgpu;gltf;nativeaot;game-dev</PackageTags>
    <!-- AOT-clean: reflection-validated uniforms are explicit offset tables, not System.Reflection. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)../Slang.targets" />

  <ItemGroup>
    <SlangShader Include="Shaders/**/*.slang" />
  </ItemGroup>

  <ItemGroup>
    <!-- Backend-agnostic: this project consumes Paradise.Rendering's IRenderer (the resource +
         submit surface PbrRenderer and MaterialResourceCache actually call) and never names a
         concrete backend. The interface was extracted once a second one arrived; hosts pick the
         backend package (Paradise.Rendering.WebGPU for desktop/Dawn) and hand the instance in.
         Consumers upgrading past 0.6.x no longer get Paradise.Rendering.WebGPU transitively and
         must reference it themselves. -->
    <ProjectReference Include="..\Paradise.Rendering\Paradise.Rendering.csproj" />
    <ProjectReference Include="..\Paradise.Assets.Gltf\Paradise.Assets.Gltf.csproj" />
    <ProjectReference Include="..\Paradise.Assets.Textures\Paradise.Assets.Textures.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Paradise.Rendering.Pbr.Test" />
  </ItemGroup>

</Project>
