<Project>

  <!-- Provide packaged Slang tooling and PBR includes for game shaders. An existing source override
         takes precedence through SlangTargetsImported. -->

  <PropertyGroup Condition="'$(SlangTargetsImported)' != 'true'">
    <ParadisePbrShaderDir Condition="'$(ParadisePbrShaderDir)' == ''">$(MSBuildThisFileDirectory)../shaders/</ParadisePbrShaderDir>
    <SlangManifestPath Condition="'$(SlangManifestPath)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/slang/slang.manifest.json'))</SlangManifestPath>
    <SlangBootstrapProject Condition="'$(SlangBootstrapProject)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/slang/SlangBootstrap.csproj'))</SlangBootstrapProject>
    <!-- The bootstrap csproj lives in the NuGet cache; its obj/bin must land in the consumer's
         intermediate dir, never beside the package. -->
    <SlangBootstrapOutputRoot Condition="'$(SlangBootstrapOutputRoot)' == ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'slang-bootstrap'))))/</SlangBootstrapOutputRoot>
  </PropertyGroup>

  <!-- Test the shader-directory property: imports set the sentinel before items evaluate. An unset
         property means the source override supplies its own include path. -->
  <ItemGroup Condition="'$(ParadisePbrShaderDir)' != ''">
    <SlangIncludeDir Include="$(ParadisePbrShaderDir)" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)Slang.targets" Condition="'$(SlangTargetsImported)' != 'true'" />

</Project>
