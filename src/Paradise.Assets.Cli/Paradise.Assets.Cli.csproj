<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The `paradise-assets` command — a thin shell over Paradise.Assets.Pipeline. Ships as a
    dotnet tool (the repo's first; the recommended option of #179's packaging decision), so a
    game repo takes it as a tool-manifest entry and CI as `dotnet tool restore`.

    Argument parsing is by hand: three verbs and two flags do not justify a dependency, and
    every verb's real logic lives (tested) in the pipeline library.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>paradise-assets</AssemblyName>
    <RootNamespace>Paradise.Assets.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>paradise-assets</ToolCommandName>
    <PackageId>Paradise.Assets.Cli</PackageId>
    <Title>paradise-assets</Title>
    <Description>The Paradise asset project CLI: verify the source tree, police canonical form, clean derived output, build (coming with the pipeline steps).</Description>
    <PackageTags>assets;pipeline;cli;dotnet-tool;game-dev</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paradise.Assets.Pipeline\Paradise.Assets.Pipeline.csproj" />
  </ItemGroup>

</Project>
