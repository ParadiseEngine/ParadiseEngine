<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Paradise.Ui</AssemblyName>
    <RootNamespace>Paradise.Ui</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Title>Paradise.Ui</Title>
    <PackageId>Paradise.Ui</PackageId>
    <Description>UI input and fixed-tick updates over WindowEvent, with CompositeUiInput for stacking UI systems.</Description>
    <PackageTags>ui;input;game-dev</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reuse the window input vocabulary without adding a renderer dependency. -->
    <ProjectReference Include="../Paradise.Windowing/Paradise.Windowing.csproj" />
  </ItemGroup>

</Project>
