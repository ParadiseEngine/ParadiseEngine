<Project>
  <ItemGroup>
    <!-- Roslyn / Source Generators -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <!-- Microsoft.Extensions.Logging.Abstractions (including LoggerMessage generators) ships in
         the .NET 11 shared framework, so net11.0 projects require no package reference. -->
    <!-- Rendering -->
    <PackageVersion Include="WebGPUSharp" Version="0.5.8" />
    <PackageVersion Include="Noesis.GUI" Version="4.0.1.18263" />
    <!-- Paradise.ImGui is our unofficial fork of Hexa.NET.ImGui (github.com/ParadiseEngine/Paradise.ImGui),
         renamed because upstream's license forbids the Hexa.NET name on modified packages. It keeps
         the Hexa.NET.* assemblies and namespaces, builds natives at -O3 from pinned sources and adds
         a browser-wasm cimgui. It exposes the DockBuilder internals and desktop natives required by
         the editor. Review upgrades explicitly.
         Obsolete atlas APIs are stripped, so the ImGui 1.92 texture protocol is required.
         Do not add win-arm64 until Hexa.NET.ImGui#90 (MSVC HVA ABI) is resolved.
         Use TextUnformatted / ImGuiText: printf formatting in Text(string) can crash (#130). -->
    <PackageVersion Include="Paradise.ImGui" Version="3.1.2" />
    <!-- Keep ImGuizmo and ImGui versions in lockstep. Its native library has a separate ImGui
         context; EditorGizmo.Attach must call SetImGuiContext before use.
         ImPlot/ImNodes have no current consumer. Widgets uses an incompatible pin and host-path
         dialogs, while editor state and file access belong to our shell and Zio mounts. -->
    <PackageVersion Include="Paradise.ImGui.Guizmo" Version="3.1.2" />
    <PackageVersion Include="ppy.SDL3-CS" Version="2026.1002.1" />
    <PackageVersion Include="Ktx2.NET" Version="1.0.5" />
    <!-- Asset project + tooling: Zio supplies virtual filesystems (MemoryFileSystem in tests).
         Tomlyn handles TOML models and serialization; typed settings readers supply generated
         serializer contexts for AOT-compatible binding. -->
    <PackageVersion Include="Zio" Version="0.25.0" />
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
    <PackageVersion Include="Tomlyn" Version="2.11.1" />
    <!-- Export pipeline. The navmesh BINARY FORMAT is the contract, not the package version:
         NavMeshBinaryWriterTests pins the bytes, so a bump that passes them is compatible — and
         an editor vendoring DotRecast must produce those same bytes, whatever version it holds. -->
    <PackageVersion Include="DotRecast.Core" Version="2026.3.1" />
    <PackageVersion Include="DotRecast.Detour" Version="2026.3.1" />
    <PackageVersion Include="DotRecast.Recast" Version="2026.3.1" />
    <!-- Testing (TUnit with Native AOT support) -->
    <PackageVersion Include="TUnit" Version="1.87.0" />
    <PackageVersion Include="Microsoft.Coyote.Test" Version="1.7.11" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <!-- Benchmarking -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
  </ItemGroup>
</Project>
