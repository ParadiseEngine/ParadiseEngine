<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ManagedAotSmoke</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <ManagedSmokeTags Condition="'$(ManagedSmokeTags)' == ''">true</ManagedSmokeTags>
    <DefineConstants Condition="'$(ManagedSmokeTags)' == 'true'">$(DefineConstants);MANAGED_SMOKE_TAGS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="RootNamespace" />
  </ItemGroup>
  <ItemGroup Condition="'$(ManagedSmokePackages)' != 'true'">
    <ProjectReference Include="../../src/Paradise.ECS.Managed/Paradise.ECS.Managed.csproj" />
    <ProjectReference Include="../../src/Paradise.ECS.Tag/Paradise.ECS.Tag.csproj" Condition="'$(ManagedSmokeTags)' == 'true'" />
    <ProjectReference Include="../../src/Paradise.ECS.Generators/Paradise.ECS.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(ManagedSmokePackages)' == 'true'">
    <PackageReference Include="Paradise.ECS.Managed" Version="$(ManagedSmokeVersion)" />
    <PackageReference Include="Paradise.ECS.Tag" Version="$(ManagedSmokeVersion)" Condition="'$(ManagedSmokeTags)' == 'true'" />
  </ItemGroup>
</Project>
