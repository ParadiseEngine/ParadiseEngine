<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone Slang installer. A normal project avoids shared dotnet run-file cache races. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Paradise.Slang.Bootstrap</RootNamespace>
    <AssemblyName>SlangBootstrap</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Keep this dependency-free bootstrap outside the main solution and central package management. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- Console entry points have no synchronization context; suppress CA2007 and inherited warning escalation. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>

</Project>
